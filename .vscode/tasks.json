{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Verify Dashboard ESLint",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint",
				"--prefix",
				"Frontend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Backend Tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"test",
				"--prefix",
				"Backend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove Demo Hotel Records",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"remove:demo-hotels",
				"--prefix",
				"Backend",
				"--",
				"--confirm"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recheck Hotel Inventory",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"inventory:inspect",
				"--prefix",
				"Backend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build",
				"--prefix",
				"Frontend"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}